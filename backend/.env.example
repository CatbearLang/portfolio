# Any OpenAI-compatible endpoint. The live demo uses OpenRouter with a free model.
#   OpenRouter: https://openrouter.ai/api/v1     (model: any ":free" model with tool calling)
#   Groq:       https://api.groq.com/openai/v1   (model: llama-3.1-8b-instant)
#   Ollama:     http://localhost:11434/v1        (model: llama3.1, key can be empty)
LLM_PROVIDER=openai          # openai | fake (offline demo/tests)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
EMBED_BACKEND=model2vec      # model2vec (default, ~30 MB) | hash (tests, no download)
MODEL2VEC_MODEL=minishlab/potion-base-8M
TOP_K=3
RETRIEVAL_MIN_SCORE=0.25     # hybrid score scale: 0.6 * bm25/(bm25+4) + 0.4 * cosine
SKIP_GRADE_SCORE=0.6         # top hit at or above this skips the LLM relevance-grading call
CLIENT_IP_HEADERS=cf-connecting-ip   # header set by the hosting edge; else X-Forwarded-For from the right
TRUSTED_PROXY_HOPS=1
IP_DAILY=8
IP_BURST=3
GLOBAL_DAILY=40
CORS_ORIGINS=http://localhost:5173,https://catbearlang.github.io
