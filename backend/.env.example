# Any OpenAI-compatible endpoint. Examples:
#   Groq:       https://api.groq.com/openai/v1   (model: llama-3.1-8b-instant)
#   OpenRouter: https://openrouter.ai/api/v1     (model: meta-llama/llama-3.1-8b-instruct:free)
#   Ollama:     http://localhost:11434/v1        (model: llama3.1, key can be empty)
LLM_PROVIDER=openai          # openai | fake (offline demo/tests)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
EMBEDDER=fastembed           # fastembed (free, local) | hash (no download)
EMBED_MODEL=BAAI/bge-small-en-v1.5
MIN_SCORE=0.5
CORS_ORIGINS=http://localhost:5173,https://catbearlang.github.io
